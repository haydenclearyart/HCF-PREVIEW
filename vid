.video-shell::before{content:'';position:absolute;inset:-2px;border-radius:6px;background:linear-gradient(135deg,#7B3FF2,#CF4530,#A855F7,#7B3FF2);background-size:300% 300%;animation:gradshift 6s ease infinite;z-index:-1;filter:blur(8px);opacity:.6}
