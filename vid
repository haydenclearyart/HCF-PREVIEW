<script>
const pricing = {
  dd: {
    starter:   { amount: '60', total: '$240 billed as one payment',  saving: '' },
    transform: { amount: '57', total: '$456 billed as one payment',  saving: '' },
    fullsend:  { amount: '55', total: '$660 billed as one payment',  saving: '' },
  },
  up: {
    starter:   { amount: '50', total: '$200 paid upfront', saving: 'Save $40' },
    transform: { amount: '47', total: '$376 paid upfront', saving: 'Save $80' },
    fullsend:  { amount: '45', total: '$540 paid upfront', saving: 'Save $120' },
  }
};

let isUpfront = false;

function flipToggle() {
  isUpfront = !isUpfront;
  const track   = document.getElementById('toggle');
  const optDD   = document.getElementById('opt-dd');
  const optUP   = document.getElementById('opt-up');
  const badge   = document.getElementById('save-badge');

  track.classList.toggle('upfront', isUpfront);
  optDD.classList.toggle('active',   !isUpfront);
  optDD.classList.toggle('inactive',  isUpfront);
  optUP.classList.toggle('active',    isUpfront);
  optUP.classList.toggle('inactive', !isUpfront);
  badge.classList.toggle('visible',   isUpfront);

  const mode = isUpfront ? 'up' : 'dd';
  ['starter', 'transform', 'fullsend'].forEach(t => {
    const p = pricing[mode][t];
    document.getElementById('price-'  + t).textContent = p.amount;
    document.getElementById('total-'  + t).textContent = p.total;
    document.getElementById('saving-' + t).textContent = p.saving;
  });
}
</script>
