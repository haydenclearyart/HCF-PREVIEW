  0%{background-position:0% 50%}
  50%{background-position:100% 50%}
  100%{background-position:0% 50%}
}
.video-inner{background:#0D0D14;border-radius:2px;overflow:hidden;position:relative;aspect-ratio:16/9;width:100%}
.video-inner iframe,.video-inner video{width:100%;height:100%;display:block;border:none}


